        <mxCell id="e2" value="full_text (pages)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#33475b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ocr" target="proofread">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="raw OCR text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#33475b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ocr" target="structure">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="OCR text + original doc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#33475b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ocr" target="export">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="15" y="218" />
              <mxPoint x="15" y="557" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e5" value="raw OCR (grounding)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#33475b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="ocr" target="chat">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="758" y="218" />
              <mxPoint x="758" y="526" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e6" value="fields" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#33475b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="structure" target="chat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==== Dashed "runs on" edges (stage -> llama-server) ==== -->
        <mxCell id="d1" value="OCR VLM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#9aa4ad;fontSize=10;fontColor=#788089;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ocr" target="srv_surya">
          <mxGeometry relative="1" as="geometry" />
