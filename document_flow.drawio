<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.7">
  <diagram name="Document Processes" id="document-processes">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Processes applied to the document&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="in" value="&lt;b&gt;Document&lt;/b&gt;&lt;br&gt;PDF or image" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="&lt;b&gt;1. QR Scanning&lt;/b&gt;&lt;br&gt;detect QR codes, safety-check the links, capture linked pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="180" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p2" value="&lt;b&gt;2. Text Extraction (OCR)&lt;/b&gt;&lt;br&gt;read Arabic/English text, layout and reading order from every page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="280" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p3" value="&lt;b&gt;3. Proofreading&lt;/b&gt;&lt;br&gt;fix Arabic spelling and grammar while protecting numbers, dates and IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="380" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p4" value="&lt;b&gt;4. Classification&lt;/b&gt;&lt;br&gt;identify the document type (وكالة، حصر ورثة، ملكية عقار …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="480" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p5" value="&lt;b&gt;5. Structuring&lt;/b&gt;&lt;br&gt;extract the document's fields, each cited back to its page and line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="590" width="280" height="75" as="geometry" />
        </mxCell>

        <mxCell id="p6" value="&lt;b&gt;6. Expiration Check&lt;/b&gt;&lt;br&gt;find the expiry date, convert Hijri → Gregorian, decide valid / expiring / expired / cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="590" width="280" height="75" as="geometry" />
        </mxCell>

        <mxCell id="p7" value="&lt;b&gt;7. Related Regulations&lt;/b&gt;&lt;br&gt;retrieve the regulation clauses relevant to the document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
