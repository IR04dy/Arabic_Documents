# Vendored GPU runtime for the structured-data stage (~1.5 GB).
# Reinstall with:  ./fetch_llama_server.ps1
vendor/

# Python
__pycache__/
*.pyc

# Local logs / outputs
*.log
models/

.venv/

# macOS
.DS_Store

# Complaint-management register (SQLite) and uploaded complaint files: personal data, never committed
data/

# Secrets: API keys (e.g. WATHQ_API_KEY_FILE) belong outside the repo; these
# patterns stop one dropped here by mistake from being committed.
.env
.env.*
*.key
secrets/
